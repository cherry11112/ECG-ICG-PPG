{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/feedback/:path*",
      "destination": "/api/feedback/[...slug]"
    },
    {
      "source": "/api/diagnostic/:path*",
      "destination": "/api/diagnostic/[...slug]"
    },
    {
      "source": "/api/documents/:path*",
      "destination": "/api/documents/[...slug]"
    }
  ]
}